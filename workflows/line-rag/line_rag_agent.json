      "parameters": {
        "jsCode": "const raw = $input.item.json.output || '';\n\nconst text = raw\n  .replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, '$1')  // 移除 Markdown 連結，保留文字\n  .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')         // 移除粗體 **\n  .replace(/^#{1,6}\\s+/gm, '')               // 移除標題 ###\n  .replace(/^[-*]\\s+/gm, '')                 // 移除列表符號\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn [{ json: { output: text } }];\n\n\n"
